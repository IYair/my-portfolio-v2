generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  content     String   @db.LongText
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  contentJson String?  @db.LongText
  contentType String   @default("markdown")
  tags        Tag[]    @relation("PostTags")

  @@map("posts")
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[] @relation("PostTags")

  @@map("tags")
}

model Project {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  description     String?  @db.Text
  longDescription String?  @db.LongText
  image           String?
  demoUrl         String?
  githubUrl       String?
  technologies    String   @db.Text
  featured        Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("projects")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contacts")
}

model AboutProfile {
  id           Int      @id @default(autoincrement())
  name         String
  title        String
  titleEn      String?
  subtitle     String
  subtitleEn   String?
  bio          String   @db.Text
  bioHtml      String?  @db.LongText
  bioEn        String?  @db.Text
  bioHtmlEn    String?  @db.LongText
  profileImage String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("about_profile")
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String
  icon      String   @db.Text
  category  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skills")
}

model ContactInfo {
  id         Int      @id @default(autoincrement())
  type       String
  value      String
  icon       String?  @db.Text
  isHeroicon Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("contact_info")
}

model WorkExperience {
  id              Int      @id @default(autoincrement())
  position        String
  positionEn      String?
  company         String
  description     String   @db.Text
  descriptionEn   String?  @db.Text
  startDate       String?
  endDate         String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  descriptionHtml String?  @db.LongText
  descriptionHtmlEn String? @db.LongText

  @@map("work_experience")
}

model Education {
  id          Int      @id @default(autoincrement())
  institution String
  degree      String
  degreeEn    String?
  field       String?
  fieldEn     String?
  startDate   String?
  endDate     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("education")
}

model Course {
  id           Int      @id @default(autoincrement())
  title        String
  titleEn      String?
  provider     String
  providerIcon String?  @db.Text
  icon         String?  @db.Text
  category     String?
  categoryEn   String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("courses")
}
